   "documentation": "RoboCNC MACHINE_STATUS (param 1000): 5=built-wait, 6=ready-built, etc.\n   EN is the implicit IEC 61131-3 enable pin (STruC++ gates the body on it and\n   never assigns a declared EN member) -- do not re-test EN."
  },
  {
   "name": "RCNC_NC_SYNC",
   "code": "#include <robocnc_link.h>\n\n/* FC3 read of holding registers (the P-bank lives in holding space; the\n   robocnc_read_param_* helpers only do FC4). Same PDU/locking pattern as\n   the header's other helpers. */\nstatic int rcnc_read_holding_span(int addr, int count, uint16_t *out)\n{\n    uint8_t pdu[5] = {0x03, (uint8_t)(addr >> 8), (uint8_t)addr, (uint8_t)(count >> 8),\n                      (uint8_t)count};\n    uint8_t resp[8 + 250];\n    pthread_mutex_lock(&rcnc_state.lock);\n    int n = rcnc_txn_locked(pdu, sizeof(pdu), resp, sizeof(resp));\n    pthread_mutex_unlock(&rcnc_state.lock);\n    if (n < 2 + 2 * count)\n        return -1;\n    for (int i = 0; i < count; i++)\n        out[i] = ((uint16_t)resp[2 + 2 * i] << 8) | resp[3 + 2 * i];\n    return 0;\n}\n\nstatic float span_real(const uint16_t *regs, int base_p, int p)\n{\n    uint32_t bits = ((uint32_t)regs[2 * (p - base_p) + 1] << 16) | regs[2 * (p - base_p)];\n    float out;\n    memcpy(&out, &bits, sizeof(out));\n    return out;\n}\n\n/* P-bank holding address of a writable P parameter (P1024..P2047). */\n#define P_HOLD(p) (4300 + 2 * ((p) - 1024))\n\nvoid setup() {}\n\nvoid loop() {\n    uint16_t regs[64];\n    int ok = 1;\n\n    /* -- machine words 1000..1012 -- */\n    if (rcnc_read_input_regs(1000, 13, regs) == 0) {\n        MACHINE_STATUS = (IEC_INT)(int16_t)regs[0];\n        PROG_NO = (IEC_INT)(int16_t)regs[2];\n        CURRENT_ROW = (IEC_INT)(int16_t)regs[8];\n        PROG_RUNNING = (IEC_BOOL)(regs[10] != 0);\n        MOTION_ACTIVE = (IEC_BOOL)(regs[12] != 0);\n    } else {\n        ok = 0;\n    }\n\n    /* -- axis positions, 7 axes (POSIN 0..13, REAL lo-word-first) -- */\n    if (rcnc_read_input_regs(0, 14, regs) == 0) {\n        float p[7];\n        for (int i = 0; i < 7; i++) {\n            uint32_t bits = ((uint32_t)regs[2 * i + 1] << 16) | regs[2 * i];\n            memcpy(&p[i], &bits, sizeof(float));\n        }\n        POS_AX0 = p[0]; POS_AX1 = p[1]; POS_AX2 = p[2]; POS_AX3 = p[3];\n        POS_AX4 = p[4]; POS_AX5 = p[5]; POS_AX6 = p[6];\n    } else {\n        ok = 0;\n    }\n\n    /* -- axis status masks (900+i: b0 enabled, b1 homed, b2 done, b11 fault) -- */\n    if (rcnc_read_input_regs(900, 7, regs) == 0) {\n        int en = 0, hm = 0, dn = 0, ft = 0;\n        for (int i = 0; i < 7; i++) {\n            if (regs[i] & 0x0001) en |= (1 << i);\n            if (regs[i] & 0x0002) hm |= (1 << i);\n            if (regs[i] & 0x0004) dn |= (1 << i);\n            if (regs[i] & 0x0800) ft |= (1 << i);\n        }\n        ENABLED_MASK = (IEC_INT)en;\n        HOMED_MASK = (IEC_INT)hm;\n        DONE_MASK = (IEC_INT)dn;\n        FAULT_MASK = (IEC_INT)ft;\n    } else {\n        ok = 0;\n    }\n\n    /* -- DIN handshake spans from the writable P-bank (FC3) -- */\n    /* P1700..P1710: 22 regs */\n    if (rcnc_read_holding_span(P_HOLD(1700), 22, regs) == 0) {\n        P1700 = span_real(regs, 1700, 1700);\n        P1702 = span_real(regs, 1700, 1702);\n        P1703 = span_real(regs, 1700, 1703);\n        P1705 = span_real(regs, 1700, 1705);\n        P1710 = span_real(regs, 1700, 1710);\n    } else {\n        ok = 0;\n    }\n    /* P1835..P1837: 6 regs */\n    if (rcnc_read_holding_span(P_HOLD(1835), 6, regs) == 0) {\n        P1835 = span_real(regs, 1835, 1835);\n        P1837 = span_real(regs, 1835, 1837);\n    } else {\n        ok = 0;\n    }\n    /* P2029..P2047: 38 regs */\n    if (rcnc_read_holding_span(P_HOLD(2029), 38, regs) == 0) {\n        P2029 = span_real(regs, 2029, 2029);\n        P2044 = span_real(regs, 2029, 2044);\n        P2046 = span_real(regs, 2029, 2046);\n        P2047 = span_real(regs, 2029, 2047);\n    } else {\n        ok = 0;\n    }\n\n    LINK_OK = (IEC_BOOL)ok;\n}",

   "documentation": "RoboCNC M-code reset/ack: releases blocking M<N> / clears latched UM<N>.\n   EN is the implicit IEC 61131-3 enable pin (STruC++ gates the body on it and\n   never assigns a declared EN member) -- do not re-test EN."
  },
  {
   "name": "M_DISPATCH",
   "code": "#include <robocnc_link.h>\n\n/* FC1 span read of the whole M-coil window. */\nstatic int mdisp_read_coils(int addr, int count, uint8_t *bits /* count/8 bytes */)\n{\n    uint8_t pdu[5] = {0x01, (uint8_t)(addr >> 8), (uint8_t)addr, (uint8_t)(count >> 8),\n                      (uint8_t)count};\n    uint8_t resp[2 + 128 + 8];\n    pthread_mutex_lock(&rcnc_state.lock);\n    int n = rcnc_txn_locked(pdu, sizeof(pdu), resp, sizeof(resp));\n    pthread_mutex_unlock(&rcnc_state.lock);\n    int nbytes = (count + 7) / 8;\n    if (n < 2 + nbytes)\n        return -1;\n    memcpy(bits, resp + 2, nbytes);\n    return 0;\n}\n\nstatic const int mdisp_known[] = {0,   1,   30,  100, 101, 200, 201, 250, 300,\n                                  301, 400, 401, 450, 500, 850, 851, 950, 999};\n\nstatic int mdisp_bit(const uint8_t *bits, int n) { return (bits[n / 8] >> (n % 8)) & 1; }\n\nvoid setup() {}\n\nvoid loop() {\n    uint8_t bits[128];\n    if (mdisp_read_coils(0, 1024, bits) != 0) {\n        LINK_OK = 0;\n        M0 = M1 = M30 = M100 = M101 = M200 = M201 = M250 = 0;\n        M300 = M301 = M400 = M401 = M450 = M500 = M850 = M851 = M950 = M999 = 0;\n        UNKNOWN_M = 0;\n        return;\n    }\n    LINK_OK = 1;\n\n    M0 = mdisp_bit(bits, 0);\n    M1 = mdisp_bit(bits, 1);\n    M30 = mdisp_bit(bits, 30);\n    M100 = mdisp_bit(bits, 100);\n    M101 = mdisp_bit(bits, 101);\n    M200 = mdisp_bit(bits, 200);\n    M201 = mdisp_bit(bits, 201);\n    M250 = mdisp_bit(bits, 250);\n    M300 = mdisp_bit(bits, 300);\n    M301 = mdisp_bit(bits, 301);\n    M400 = mdisp_bit(bits, 400);\n    M401 = mdisp_bit(bits, 401);\n    M450 = mdisp_bit(bits, 450);\n    M500 = mdisp_bit(bits, 500);\n    M850 = mdisp_bit(bits, 850);\n    M851 = mdisp_bit(bits, 851);\n    M950 = mdisp_bit(bits, 950);\n    M999 = mdisp_bit(bits, 999);\n\n    UNKNOWN_M = 0;\n    if (AUTO_ACK) {\n        for (int n = 0; n < 1024; n++) {\n            if (!mdisp_bit(bits, n))\n                continue;\n            int known = 0;\n            for (unsigned k = 0; k < sizeof(mdisp_known) / sizeof(mdisp_known[0]); k++)\n                if (mdisp_known[k] == n) { known = 1; break; }\n            if (!known && UNKNOWN_M == 0)\n                UNKNOWN_M = (IEC_INT)n;\n            /* Z-stage codes stay blocking until the PLC acks them on the\n               limit switch (replaces the dead Eckelmann G152 wait). */\n            if ((n == 450 && HOLD450) || (n == 500 && HOLD500))\n                continue;\n            robocnc_mcode_reset(n); /* quitt */\n        }\n    }\n}",

     {
      "name": "ST_OVR",
      "class": "local",
      "type": {
       "definition": "base-type",
       "value": "INT"
      },
      "location": "%QW384",
      "initialValue": null,
      "documentation": "PLC->HMI: the feed override this program set, % (100 outside simulation)",
      "debug": false
     },
     {
      "name": "wp_ovr",
      "class": "local",
      "type": {
       "definition": "user-data-type",
       "value": "WRITE_PARAM_INT"
      },
      "location": "",
      "initialValue": null,
      "documentation": "",
      "debug": false
     },
     {
      "name": "want",
      "class": "local",
      "type": {
       "definition": "base-type",
       "value": "INT"
      },
      "location": "",
      "initialValue": "100",
      "documentation": "",
      "debug": false
     },
     {
      "name": "written",
      "class": "local",
      "type": {
       "definition": "base-type",
       "value": "INT"
      },
      "location": "",
      "initialValue": "100",
      "documentation": "",
      "debug": false
     },
     {
      "name": "req_l",
      "class": "local",
      "type": {
       "definition": "base-type",
       "value": "INT"
      },
      "location": "",
      "initialValue": null,
      "documentation": "",
      "debug": false
     },
     {
      "name": "sim_l",
      "class": "local",
      "type": {
       "definition": "base-type",
       "value": "BOOL"
      },
      "location": "",
      "initialValue": null,
      "documentation": "",
      "debug": false
     }
    ]
   },
   "body": {
    "language": "st",
    "value": "(* THE PANEL'S FEED OVERRIDE, IN SIMULATION ONLY (user, 2026-11-20). While simulation runs the panel\n   shows an override button (\"x %\") with a 0..100 % slider; robocnc's override (OVERRIDE_REQ 2050)\n   follows it. Simulation starts at 100 % whatever the slider said last, and its end puts 100 % back.\n   Written only on a change, so RoboStudio's own override is left alone outside simulation. *)\nIF SimulationActive AND NOT sim_l THEN\n\twant := 100;\n\treq_l := OVR_REQ;\nELSIF SimulationActive AND OVR_REQ <> req_l THEN\n\treq_l := OVR_REQ;\n\twant := LIMIT(0, OVR_REQ, 100);\nELSIF NOT SimulationActive AND sim_l THEN\n\twant := 100;\nEND_IF;\nsim_l := SimulationActive;\n(* written until robocnc has it *)\nIF want <> written AND CncLinkOk THEN\n\twp_ovr(ADDR := 2050, VALUE := want);\n\tIF wp_ovr.DONE THEN written := want; END_IF;\nEND_IF;\nST_OVR := want;"
   },
   "documentation": ""
  },

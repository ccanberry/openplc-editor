{
 "formatVersion": 1,
 "manifest": {
  "name": "nc_link",
  "version": "1.0.1",
  "namespace": "nc_link",
  "functions": [],
  "functionBlocks": [],
  "types": [],
  "globals": [],
  "headers": [],
  "isBuiltin": true,
  "sourceFiles": [],
  "displayName": "RoboCNC NC Link (dispenser line)",
  "description": "The dispenser line's link to robocnc, delivered as a library: robocnc state and positions in, axis commands and parameters out, program start, catalogue, parameter check, the HMI's developer page and override, the reaction to an emergency stop and the reference. Needs robocnc_link."
 },
 "chunks": [],
 "dependencies": [],
 "sources": [],
 "cppBlocks": [],
 "stPous": [
  {
   "name": "DROP_START_REQUESTS",
   "pouType": "function",
   "interface": {
    "returnType": "BOOL",
    "variables": [
     {
      "name": "ProgramStart",
      "class": "external",
      "type": {
       "definition": "base-type",
       "value": "BYTE"
      },
      "location": "",
      "initialValue": null,
      "documentation": "",
      "debug": false
     },
     {
      "name": "ManuelDispensingStart",
      "class": "external",
      "type": {
       "definition": "base-type",
       "value": "BYTE"
      },
      "location": "",
      "initialValue": null,
      "documentation": "",
      "debug": false
     },
     {
      "name": "ManuelCleaningStart",
      "class": "external",
      "type": {
       "definition": "base-type",
       "value": "BYTE"
      },
      "location": "",
      "initialValue": null,
      "documentation": "",
      "debug": false
     },
     {
      "name": "GoMaintenanceStart",
      "class": "external",
      "type": {
       "definition": "base-type",
       "value": "BYTE"
      },
      "location": "",
      "initialValue": null,
      "documentation": "",
      "debug": false
     },
     {
      "name": "LineLoadingStart",
      "class": "external",
      "type": {
       "definition": "base-type",
       "value": "BYTE"
      },
      "location": "",
      "initialValue": null,
      "documentation": "",
      "debug": false
     },
     {
      "name": "CalibrationStart",
      "class": "external",
      "type": {
       "definition": "base-type",
       "value": "BYTE"
      },
      "location": "",
      "initialValue": null,
      "documentation": "",
      "debug": false
     }
    ]
   },
   "body": {
    "language": "st",
    "value": "(* EVERY START REQUEST DROPPED: the program start and the service requests (manual dispensing,\n   cleaning, maintenance position, line loading, calibration). The service requests are level bytes\n   START_STOP turns into ProgramStart every scan: a start that fails or is refused must drop them\n   too, or the request comes back by itself later (NC_START). *)\nProgramStart := 0;\nManuelDispensingStart := 0;\nManuelCleaningStart := 0;\nGoMaintenanceStart := 0;\nLineLoadingStart := 0;\nCalibrationStart := 0;\nDROP_START_REQUESTS := TRUE;"
   },
   "documentation": ""
  },
  {
   "name": "P_SET",
   "pouType": "function",
   "interface": {
    "returnType": "BOOL",
    "variables": [
     {
      "name": "N",
      "class": "input",
      "type": {
       "definition": "base-type",
       "value": "INT"
      },
      "location": "",
      "initialValue": null,
      "documentation": "",
      "debug": false
     },
     {
      "name": "V",
      "class": "input",
      "type": {
       "definition": "base-type",
       "value": "REAL"
      },
      "location": "",
      "initialValue": null,
      "documentation": "",
      "debug": false
     },
     {
      "name": "P_VAL",
      "class": "external",
      "type": {
       "definition": "array",
       "value": "ARRAY [0..2047] OF REAL",
       "data": {
        "baseType": {
         "definition": "base-type",
         "value": "REAL"
        },
        "dimensions": [
         {
          "dimension": "0..2047"
         }
        ]
       }
      },
      "location": "",
      "initialValue": null,
      "documentation": "",
      "debug": false
     },
     {
      "name": "P_DIRTY",
      "class": "external",
      "type": {
       "definition": "array",
       "value": "ARRAY [0..2047] OF BOOL",
       "data": {
        "baseType": {
         "definition": "base-type",
         "value": "BOOL"
        },
        "dimensions": [
         {
          "dimension": "0..2047"
         }
        ]
       }
      },
      "location": "",
      "initialValue": null,
      "documentation": "",
      "debug": false
     }
    ]
   },
   "body": {
    "language": "st",
    "value": "(* A ROBOCNC PARAMETER WRITTEN BY THE PLC: P_SET(N := n, V := v) stores P<n> := v in P_VAL and\n   marks it for sending (P_DIRTY; NC_LINK_OUT sends the marked ones to robocnc) -- only when the\n   value changed, so an unchanged value costs nothing on the link. TRUE when it changed. *)\nP_SET := P_VAL[N] <> V;\nIF P_SET THEN\n\tP_VAL[N] := V;\n\tP_DIRTY[N] := TRUE;\nEND_IF;"
   },
   "documentation": ""
  },

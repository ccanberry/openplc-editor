  {
   "name": "p_owned",
   "type": {
    "definition": "array",
    "value": "ARRAY [1024..2047] OF BOOL",
    "data": {
     "baseType": {
      "definition": "base-type",
      "value": "BOOL"
     },
     "dimensions": [
      {
       "dimension": "1024..2047"
      }
     ]
    }
   },
   "location": "",
   "initialValue": null,
   "documentation": "the P parameters this PLC has written to robocnc (PLC_PRG's flush); PARAM_VERIFY counts them",
   "debug": false,
   "group": "NC_Link"
  },
  {
   "name": "PlcAxisLink",
   "type": {
    "definition": "array",
    "value": "ARRAY [0..15] OF ST_PlcAxis",
    "data": {
     "baseType": {
      "definition": "user-data-type",
      "value": "ST_PlcAxis"
     },
     "dimensions": [
      {
       "dimension": "0..15"
      }
     ]
    }
   },
   "location": "",
   "initialValue": null,
   "documentation": "Internal (NC_LINK_IN / NC_LINK_OUT): per PLC axis -- Zero: the position the last pump reset (jog 102) took as zero; Actual: robocnc's position in PLC units (pump degrees), before the zero; LastCmd: the last command word sent (80 stop, 100 / 101 move, 10 / 99 enable); Target: the current go-to-target's (jog 110); SeenBusy: robocnc's done bit dropped since the command; Arrived: the move has run, P(16 + axis) reports the target; CmdSince: NcLink.Clock when the command was given",
   "debug": false,
   "group": "NC_Link"
  },
  {
   "name": "NcLink",
   "type": {
    "definition": "user-data-type",
    "value": "ST_NcLink"
   },
   "location": "",
   "initialValue": null,
   "documentation": "Internal (the link programs' shared state) -- Clock: now, by NC_LINK_IN's free-running clock (restarts every 20 days); StopCode: what a dropped enable sends (99 disable, 81 after an emergency stop: braked, the reference kept); StartStep: NC_START's sequence (0 idle, 1 build requested, 2 run requested); RefAskAfterEmergency: an emergency stop was pressed, the HMI asks \"Reference the axes?\" again; CmdPending: per robocnc axis, an enable / disable / stop robocnc has not taken yet",
   "debug": false,
   "group": "NC_Link"
  },
  {
   "name": "seed_done",
   "type": {
    "definition": "base-type",
    "value": "BOOL"
   },
   "location": "",
   "initialValue": null,
   "documentation": "every parameter this PLC owns has reached robocnc and PARAM_SEED_DONE was told (PLC_PRG); PARAM_VERIFY clears it to send them all again",
   "debug": false,
   "group": "NC_Link"
  },
  {
   "name": "ParamsVerified",
   "type": {
    "definition": "base-type",
    "value": "BOOL"
   },
   "location": "",
   "initialValue": null,
   "documentation": "robocnc holds every parameter this PLC owns (PARAM_VERIFY): a program may start",
   "debug": false,
   "group": "NC_Link"
  },
  {
   "name": "ParamsVerifyFailed",
   "type": {
    "definition": "base-type",
    "value": "BOOL"
   },
   "location": "",
   "initialValue": null,
   "documentation": "robocnc did not get the PLC's parameters back within 10 s of a start request (PARAM_VERIFY): the start is dropped",
   "debug": false,
   "group": "NC_Link"
  },

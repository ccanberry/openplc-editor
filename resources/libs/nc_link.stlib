   "body": {
    "language": "st",
    "value": "(* THE PROGRAM CATALOGUE (PLC_PRG's 500 ms group): what robocnc holds and the init versions of the\n   program the HMI asks about, for the HMI's program picker. *)\nrcnc_cat(QUERY_PROG := NcProgQuery);\nIF rcnc_cat.LINK_OK THEN\n\tNcCatalogSeq := rcnc_cat.SEQ;\n\tNcProgCount := rcnc_cat.COUNT;\n\tNcProgList := rcnc_cat.PROGS;\n\tNcVersionProg := rcnc_cat.VERSION_PROG;\n\tNcVersionCount := rcnc_cat.VERSION_COUNT;\n\tNcVersionWords := rcnc_cat.VERSION_WORDS;\n\tNcVersionActive := rcnc_cat.VERSION_ACTIVE;\n\tNcProgListed := rcnc_cat.LISTED;\n\tNcProgNames := rcnc_cat.NAMES;\nEND_IF;"
   },
   "documentation": ""
  },
